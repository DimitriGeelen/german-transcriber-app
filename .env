# Example environment variables for the Whisper Transcriber App
# Copy this file to .env and modify as needed.

# Whisper model size (e.g., tiny, base, small, medium, large). 
# Smaller models are faster but less accurate.
# Defaults to "base" if not set.
WHISPER_MODEL_SIZE=base

# Language for transcription (ISO 639-1 code or full name).
# Defaults to "german" if not set.
SUPPORTED_LANGUAGE=german

# Directory to store temporary uploaded WAV files.
# Defaults to "./uploads" if not set.
# Ensure this path does not contain '..' for security.
UPLOAD_DIR=./uploads

# Directory to store the final transcript TXT files.
# Defaults to "./transcripts" if not set.
# Ensure this path does not contain '..' for security.
TRANSCRIPT_DIR=./transcripts

# Optional: Host and Port for the development server (uvicorn)
# Defaults to 127.0.0.1:8000
# HOST=0.0.0.0 # Makes the server accessible on your network
# PORT=8001 